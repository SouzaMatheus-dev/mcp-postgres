<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>McpPostgres</RootNamespace>
    <AssemblyName>McpPostgres</AssemblyName>

    <!-- NuGet -->
    <PackageId>McpPostgres</PackageId>
    <Version>0.1.0</Version>
    <Authors>matneves</Authors>
    <Company>SouzaMatheus-dev</Company>
    <Description>Servidor MCP especialista em PostgreSQL: mapeamento, auditoria e consultas somente leitura.</Description>
    <PackageTags>mcp;postgresql;postgres;readonly;gemini;cursor;dnx;database-tools</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/SouzaMatheus-dev/mcp-postgres</PackageProjectUrl>
    <RepositoryUrl>https://github.com/SouzaMatheus-dev/mcp-postgres</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- dotnet tool + dotnet dnx -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>mcp-postgres</ToolCommandName>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="McpPostgres.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.4" />
    <PackageReference Include="ModelContextProtocol" Version="1.4.1" />
    <PackageReference Include="Npgsql" Version="9.0.3" />
  </ItemGroup>

</Project>
